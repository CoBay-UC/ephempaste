# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=EphemPaste
APP_BASE_URL=http://localhost:8080
APP_PORT=8080
APP_ENV=production
APP_DEBUG=false

# -----------------------------------------------------------------------------
# Paste settings
# -----------------------------------------------------------------------------
PASTE_CODE_LENGTH=6
PASTE_MAX_LENGTH=5000
PASTE_LIFETIME_HOURS=72
PASTE_CODE_CHARSET=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~
CLEANUP_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# Database
#
# These are the ONLY database credentials to configure. Docker Compose maps
# them to PostgreSQL's POSTGRES_* variables automatically.
# -----------------------------------------------------------------------------
DB_HOST=database
DB_PORT=5432
DB_NAME=ephempaste
DB_USER=ephempaste
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
